{
  "name": "@esbenwiberg/repofit",
  "version": "1.2.1",
  "description": "Measure how agent-friendly your repo is.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "repofit": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./sdk/recipes": {
      "types": "./dist/sdk/recipes/index.d.ts",
      "default": "./dist/sdk/recipes/index.js"
    },
    "./schemas/config.v1.json": "./schemas/config.v1.json",
    "./schemas/baseline.v1.json": "./schemas/baseline.v1.json"
  },
  "files": [
    "dist/",
    "schemas/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@esbenwiberg/corpus-default": "^1.2.1",
    "commander": "^15.0.0",
    "ignore": "^7.0.14",
    "openai": "^7.47.0"
  }
}
